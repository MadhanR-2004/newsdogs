GROQ_API_KEY=your-groq-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
SERPER_API_KEY=your-serper-api-key

# Tuning — scheduling (defaults sized to stay under Groq free tier 70B: 100k tok/day)
SCHEDULE_INTERVAL_MINUTES=180   # fetch + triage 8x/day (triage runs on the 8B model)
ALERT_INTERVAL_MINUTES=90       # ~16 investigations/day on the 70B
MAX_ARTICLES_PER_RUN=270        # cap on new articles kept per fetch cycle
TRIAGE_POOL_LIMIT=40            # max untriaged articles (new + leftover) sent to triage

# Tuning — RSS fetching
MAX_PER_FEED=5                  # max NEW articles taken from each feed per cycle
FEED_FETCH_TIMEOUT=10           # hard per-feed network timeout (seconds)
FEED_FETCH_WORKERS=12           # feeds fetched in parallel

# Tuning — Groq models & limits
GROQ_MODEL=groq/llama-3.3-70b-versatile   # believer, skeptic, judge (the 100k/day budget)
GROQ_SMALL_MODEL=groq/llama-3.1-8b-instant # triage + reporter (separate, larger budget)
LLM_MAX_TOKENS=600              # cap output tokens per call
GROQ_MAX_RPM=25                 # stay under the 30 requests/min limit

LITELLM_DISABLE_PROMPT_CACHING=true
CREWAI_TELEMETRY_OPT_OUT=true