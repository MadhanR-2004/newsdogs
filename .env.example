GROQ_API_KEY=your-groq-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
SERPER_API_KEY=your-serper-api-key

# Tuning — scheduling
SCHEDULE_INTERVAL_MINUTES=120   # how often to fetch RSS + triage
ALERT_INTERVAL_MINUTES=15       # how often to investigate 1 queued article
MAX_ARTICLES_PER_RUN=270        # cap on new articles kept per fetch cycle
TRIAGE_POOL_LIMIT=150           # max untriaged articles (new + leftover) sent to triage

# Tuning — RSS fetching
MAX_PER_FEED=5                  # max NEW articles taken from each feed per cycle
FEED_FETCH_TIMEOUT=10           # hard per-feed network timeout (seconds)
FEED_FETCH_WORKERS=12           # feeds fetched in parallel

# Tuning — Groq rate limiting (stay under your tier's requests/min)
GROQ_MAX_RPM=25

LITELLM_DISABLE_PROMPT_CACHING=true
CREWAI_TELEMETRY_OPT_OUT=true